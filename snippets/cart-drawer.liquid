<div id="cart-drawer" class="cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Cart">
  <div class="cart-drawer__overlay"></div>
  <div class="cart-drawer__panel">

    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">Your Cart</h2>
      <button class="cart-drawer__close" aria-label="Close cart">&#x2715;</button>
    </div>

    <div class="cart-drawer__body">
      <p class="cart-drawer__loading">Loading&hellip;</p>
    </div>

    <div class="cart-drawer__footer" hidden>
      <div class="cart-drawer__total-row">
        <span>Total</span>
        <span class="cart-drawer__total"></span>
      </div>
      <a href="/checkout" class="cart-drawer__checkout-btn">Checkout</a>
    </div>

  </div>
</div>
