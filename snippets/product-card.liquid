{%- comment -%}
  Renders a product card with size pills and add-to-cart.
  Expects: product (Shopify product object), badge (optional string)
{%- endcomment -%}

{%- assign first_variant = product.variants.first -%}
{%- assign parent_ml = product.metafields.scent_gallery.parent_ml_remaining -%}
{%- assign is_sold_out = false -%}
{%- if parent_ml != blank and parent_ml == 0 -%}{%- assign is_sold_out = true -%}{%- endif -%}

{%- comment -%} Pre-select size pill: per-product metafield default, fallback to 5ml, then 2nd variant. {%- endcomment -%}
{%- assign default_size = product.metafields.scent_gallery.default_pill | default: '5ml' | downcase -%}
{%- assign default_index = 0 -%}
{%- assign default_variant = first_variant -%}
{%- for variant in product.variants -%}
  {%- assign variant_size = variant.option1 | downcase -%}
  {%- if variant_size == default_size -%}
    {%- assign default_index = forloop.index -%}
    {%- assign default_variant = variant -%}
  {%- endif -%}
{%- endfor -%}
{%- if default_index == 0 -%}
  {%- assign variants_size = product.variants.size -%}
  {%- if variants_size < 2 -%}
    {%- assign default_index = variants_size -%}
  {%- else -%}
    {%- assign default_index = 2 -%}
  {%- endif -%}
  {%- assign fallback_idx = default_index | minus: 1 -%}
  {%- assign default_variant = product.variants[fallback_idx] | default: first_variant -%}
{%- endif -%}

<article class="product-card{% if is_sold_out %} product-card--sold-out{% endif %}" data-product-id="{{ product.id }}" data-parent-ml="{{ parent_ml | default: '' }}">
  <a class="product-card__image-link" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    <div class="product-card__image-wrap">
      {%- if product.featured_image -%}
        <img
          class="product-card__image"
          src="{{ product.featured_image | image_url: width: 360 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          loading="lazy"
          width="180"
          height="240"
        >
      {%- endif -%}
      {%- if is_sold_out -%}
        <span class="product-card__badge product-card__badge--sold-out">Sold Out</span>
      {%- else -%}
        {%- if badge != blank -%}
          <span class="product-card__badge">{{ badge }}</span>
        {%- elsif product.tags contains 'badge:Trending' -%}
          <span class="product-card__badge">Trending</span>
        {%- elsif product.tags contains 'badge:Best Seller' -%}
          <span class="product-card__badge">Best Seller</span>
        {%- elsif product.tags contains 'badge:New' -%}
          <span class="product-card__badge">New</span>
        {%- elsif product.tags contains 'badge:Popular' -%}
          <span class="product-card__badge">Popular</span>
        {%- elsif product.tags contains 'badge:Fan Fave' -%}
          <span class="product-card__badge">Fan Fave</span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </a>

  <div class="product-card__info">
    <div class="product-card__meta-row">
      <p class="product-card__brand">{{ product.vendor }}</p>
      {%- assign rating = product.metafields.reviews.rating.value -%}
      {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
      {%- if rating != blank -%}
        <span class="product-card__stars-inline" aria-label="{{ rating }} stars{% if rating_count %}, {{ rating_count }} reviews{% endif %}">
          <svg class="star-mini" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          <span class="product-card__rating-num">{{ rating | round: 1 }}</span>
          {%- if rating_count != blank -%}
            <span class="product-card__rating-count">({{ rating_count }})</span>
          {%- endif -%}
        </span>
      {%- endif -%}
    </div>
    <h3 class="product-card__name">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    <form method="post" action="/cart/add" class="product-card__form">
      <input type="hidden" name="id" value="{{ default_variant.id }}" class="product-card__variant-id">
      <input type="hidden" name="quantity" value="1">

      <div class="product-card__sizes" role="group" aria-label="Select size">
        {%- for variant in product.variants -%}
          {%- comment -%} Skip legacy "+" pressurized variants; pressurization is now a separate add-on. {%- endcomment -%}
          {%- unless variant.option1 contains '+' -%}
            {%- assign v_pill_size = variant.option1 | downcase | remove: '+' -%}
            {%- assign v_pill_ml = v_pill_size | remove: 'ml' | plus: 0 -%}
            {%- assign v_pill_unavail = false -%}
            {%- if parent_ml != blank and parent_ml > 0 and v_pill_ml > 0 and v_pill_ml > parent_ml -%}{%- assign v_pill_unavail = true -%}{%- endif -%}
            <button
              type="button"
              class="size-pill{% if forloop.index == default_index %} size-pill--active{% endif %}{% if v_pill_unavail %} size-pill--unavailable{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price }}"
              data-size="{{ variant.option1 | downcase }}"
              data-ml="{{ v_pill_ml }}"
              data-sprays="{{ variant.metafields.custom.sprays }}"
              data-label="{{ variant.metafields.custom.size_label }}"
              aria-pressed="{% if forloop.index == default_index %}true{% else %}false{% endif %}"
              {% if v_pill_unavail %}aria-disabled="true"{% endif %}
            >{{ variant.option1 }}</button>
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <p class="product-card__price" data-base-price="{{ default_variant.price }}">
        {{- default_variant.price | money -}}
      </p>

      {%- comment -%}
        Pressurized atomizer toggle — revealed by JS when active size pill is 10ml / 30ml.
        Off by default. When ON, the card form submits two line items: the base size
        variant (tagged Bottle Type: Pressurized) + the upgrade product line item.
      {%- endcomment -%}
      <div class="pressurized-toggle product-card__pressurized" aria-hidden="true">
        <div class="pressurized-toggle__inner">
          <div class="pressurized-toggle__info">
            <span class="pressurized-toggle__name">Upgrade to pressurized</span>
            <span class="pressurized-toggle__sub">Stronger projection &middot; ~<span class="product-card__pressurized-sprays"></span> sprays</span>
          </div>
          <div class="pressurized-toggle__right">
            <span class="pressurized-toggle__price product-card__pressurized-price"></span>
            <button
              class="pressurized-toggle__btn product-card__pressurized-btn"
              type="button"
              aria-pressed="false"
              aria-label="Upgrade to pressurized atomizer"
            >
              <span class="pressurized-toggle__track">
                <span class="pressurized-toggle__thumb-pill"></span>
              </span>
            </button>
          </div>
        </div>
      </div>

      {%- if is_sold_out -%}
        <button type="button" class="product-card__cta product-card__cta--sold-out" disabled aria-disabled="true">Sold Out</button>
      {%- else -%}
        <button type="submit" class="product-card__cta">Add to Rotation</button>
      {%- endif -%}
    </form>
  </div>
</article>
