<div id="cross-sell-modal" class="cs-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Add to your rotation">
  <div class="cs-modal__overlay"></div>
  <div class="cs-modal__sheet">
    <div class="cs-modal__header">
      <p class="cs-modal__overline">Collectors also grabbed</p>
      <button class="cs-modal__close" aria-label="Skip upsell">&#x2715;</button>
    </div>
    <div class="cs-modal__product">
      <img class="cs-modal__img" id="cs-modal-img" src="" alt="" loading="lazy" width="56" height="56">
      <div class="cs-modal__info">
        <p class="cs-modal__name" id="cs-modal-name"></p>
        <p class="cs-modal__price" id="cs-modal-price"></p>
      </div>
    </div>
    <div class="cs-modal__actions">
      <button class="btn-primary cs-modal__add" id="cs-modal-add" type="button">Add it</button>
      <button class="cs-modal__skip" id="cs-modal-skip" type="button">Skip — just add my item</button>
    </div>
  </div>
</div>
