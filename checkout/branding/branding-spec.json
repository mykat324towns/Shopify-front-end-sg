          }
        }
      }
    },
    "typography": {
      "primary": {
        "shopifyFontGroup": {
          "name": "Bodoni Moda",
          "baseWeight": 400,
          "boldWeight": 700
        }
      },
      "secondary": {
        "shopifyFontGroup": {
          "name": "Figtree",
          "baseWeight": 400,
          "boldWeight": 600
        }
      },
      "size": {
        "base": 14,
        "ratio": 1.2
      }
    },
    "cornerRadius": {
      "small": 4,
      "base": 7,
      "large": 12
    }
  },
  "customizations": {
    "global": {
      "cornerRadius": "BASE",
      "typography": {
        "letterCase": "NONE"
      }
    },
    "header": {
      "alignment": "START",
      "position": "INLINE",
      "logo": {
        "maxWidth": 160
      },
      "banner": {
        "alignment": "CENTER"
      }
    },
    "headingLevel1": {
      "typography": {
        "font": "PRIMARY",
        "size": "EXTRA_LARGE",
        "weight": "BASE",
        "letterCase": "NONE"
      }
    },
    "headingLevel2": {
      "typography": {
        "font": "PRIMARY",
        "size": "LARGE",
        "weight": "BASE",
        "letterCase": "NONE"
      }
    },
    "headingLevel3": {
      "typography": {
        "font": "PRIMARY",
        "size": "MEDIUM",
        "weight": "BASE",
        "letterCase": "NONE"
      }
    },
    "main": {
      "colorScheme": "COLOR_SCHEME1"
    },
    "orderSummary": {
      "colorScheme": "COLOR_SCHEME2"
    },
    "checkbox": {
      "cornerRadius": "SMALL"
    },
    "control": {
      "border": "FULL",
      "color": "COLOR1",
      "cornerRadius": "BASE",
      "labelPosition": "INSIDE"
    },
    "textField": {
      "border": "FULL",
      "cornerRadius": "BASE",
      "labelPosition": "INSIDE",
      "typography": {
        "font": "SECONDARY",
        "size": "BASE",
        "weight": "BASE",
        "letterCase": "NONE"
      }
    },
    "select": {
      "border": "FULL",
      "cornerRadius": "BASE",
      "labelPosition": "INSIDE",
      "typography": {
        "font": "SECONDARY",
        "size": "BASE",
        "weight": "BASE",
        "letterCase": "NONE"
      }
    },
    "primaryButton": {
      "background": "SOLID",
      "blockPadding": "BASE",
      "border": "NONE",
      "cornerRadius": "BASE",
      "inlinePadding": "BASE",
      "typography": {
        "font": "SECONDARY",
        "size": "BASE",
        "weight": "BOLD",
        "letterCase": "NONE"
      }
    },
    "secondaryButton": {
      "background": "TRANSPARENT",
      "blockPadding": "BASE",
      "border": "FULL",
      "cornerRadius": "BASE",
      "inlinePadding": "BASE",
      "typography": {
        "font": "SECONDARY",
        "size": "BASE",
        "weight": "BASE",
        "letterCase": "NONE"
      }
    },
    "buyerJourney": {
      "visibility": "VISIBLE"
    },
    "merchandiseThumbnail": {
      "border": "NONE",
      "cornerRadius": "SMALL"
    },
    "expressCheckout": {
      "button": {
        "cornerRadius": "BASE",
        "blockPadding": "BASE",
        "inlinePadding": "BASE"
      }
    },
    "footer": {
      "alignment": "START",
      "position": "INLINE",
      "content": {
        "visibility": "VISIBLE"
      }
    }
