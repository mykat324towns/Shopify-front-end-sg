<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1C4032">

  <title>
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Shopify required -->
  {{ content_for_header }}

  <!-- Fonts: preconnect + non-blocking load (media-print swap) with noscript fallback -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- assign google_fonts_url = 'https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400&family=Figtree:wght@400;600&display=swap' -%}
  <link rel="preload" as="style" href="{{ google_fonts_url }}">
  <link rel="stylesheet" href="{{ google_fonts_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ google_fonts_url }}"></noscript>

  <!-- Swiper CSS: defer until paint (only used by below-fold social wall + PDP swipers) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"></noscript>

  <!-- Critical theme CSS (above-the-fold, render-blocking on purpose) -->
  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
  {{ 'nav.css' | asset_url | stylesheet_tag }}
  {{ 'hero.css' | asset_url | stylesheet_tag }}
  {{ 'cta-trust.css' | asset_url | stylesheet_tag }}
  {{ 'best-sellers-strip.css' | asset_url | stylesheet_tag }}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}

  <!-- Deferred theme CSS (below-the-fold or template-specific) -->
  {%- assign deferred_css = 'cart.css,footer.css,collection-grid.css,scroll-indicator.css,listing-controls.css,product-page.css,size-guide.css,comparison.css,how-it-works.css,kit-builder-cta.css,faq.css,cta-section.css,testimonial-card.css,social-wall.css,back-to-top.css,delight.css' | split: ',' -%}
  {%- for css_file in deferred_css -%}
    <link rel="stylesheet" href="{{ css_file | asset_url }}" media="print" onload="this.media='all'">
  {%- endfor -%}
  <noscript>
    {%- for css_file in deferred_css -%}
      <link rel="stylesheet" href="{{ css_file | asset_url }}">
    {%- endfor -%}
  </noscript>
</head>

<body data-template="{{ template | replace: '.', '-' }}">
  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}
  {% render 'back-to-top' %}

  <!-- Swiper -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <!-- Theme JS -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script src="{{ 'scroll-indicator.js' | asset_url }}" defer></script>
  <script src="{{ 'back-to-top.js' | asset_url }}" defer></script>
</body>
</html>
