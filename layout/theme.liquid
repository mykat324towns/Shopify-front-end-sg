<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#1C4032">

  <title>
    {{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Shopify required -->
  {{ content_for_header }}

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@1,6..96,400;1,6..96,500&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Swiper -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

  <!-- Theme CSS — modular, load order matters -->
  {{ 'tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
  {{ 'nav.css' | asset_url | stylesheet_tag }}
  {{ 'cart.css' | asset_url | stylesheet_tag }}
  {{ 'footer.css' | asset_url | stylesheet_tag }}
  {{ 'hero.css' | asset_url | stylesheet_tag }}
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  {{ 'collection-grid.css' | asset_url | stylesheet_tag }}
  {{ 'listing-controls.css' | asset_url | stylesheet_tag }}
  {{ 'product-page.css' | asset_url | stylesheet_tag }}
  {{ 'size-guide.css' | asset_url | stylesheet_tag }}
  {{ 'comparison.css' | asset_url | stylesheet_tag }}
  {{ 'how-it-works.css' | asset_url | stylesheet_tag }}
  {{ 'kit-builder-cta.css' | asset_url | stylesheet_tag }}
  {{ 'faq.css' | asset_url | stylesheet_tag }}
  {{ 'cta-section.css' | asset_url | stylesheet_tag }}
  {{ 'testimonial-card.css' | asset_url | stylesheet_tag }}
</head>

<body>
  {% section 'announcement-bar' %}
  {% section 'header' %}

  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% section 'footer' %}

  {% render 'cart-drawer' %}

  <!-- Swiper -->
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
  <!-- Theme JS -->
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
