{%- paginate collection.products by 24 -%}

<section class="collection" aria-label="{{ collection.title | escape }}">
  <div class="container">

    <header class="collection-hero{% if collection.image %} collection-hero--with-image{% endif %}">
      <div class="collection-hero__text">
        <p class="collection-hero__eyebrow">{{ collection.metafields.scent_gallery.eyebrow | default: 'Collection' }}</p>
        <h1 class="collection-hero__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <p class="collection-hero__sub">{{ collection.description }}</p>
        {%- endif -%}
      </div>
      {%- if collection.image -%}
        <div class="collection-hero__media">
          <img
            src="{{ collection.image | image_url: width: 800 }}"
            alt="{{ collection.image.alt | default: collection.title | escape }}"
            loading="eager"
            width="640"
            height="400"
          >
        </div>
      {%- endif -%}
    </header>

    {%- comment -%} Subtract products tagged `hidden` from the displayed count {%- endcomment -%}
    {%- assign hidden_count = 0 -%}
    {%- for product in collection.products -%}
      {%- if product.tags contains 'hidden' -%}{%- assign hidden_count = hidden_count | plus: 1 -%}{%- endif -%}
    {%- endfor -%}
    {%- assign visible_products_count = collection.products_count | minus: hidden_count -%}

    {%- if visible_products_count > 0 -%}
      {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
      {%- assign is_main_catalog = false -%}
      {%- if collection.handle == 'all' -%}{%- assign is_main_catalog = true -%}{%- endif -%}

      {%- if is_main_catalog -%}
        <div class="listing-controls-sentinel" aria-hidden="true"></div>
      {%- endif -%}

      <div class="listing-controls{% if is_main_catalog %} listing-controls--sticky{% endif %}">
        <div class="listing-controls__top">
          <input
            id="listing-search"
            class="listing-controls__search"
            type="search"
            placeholder="Search {{ visible_products_count }} fragrance{% if visible_products_count != 1 %}s{% endif %}…"
            aria-label="Search {{ collection.title | escape }}"
            autocomplete="off"
            spellcheck="false"
          >
          <span class="listing-controls__count" id="listing-count">
            {{ visible_products_count }} fragrance{% if visible_products_count != 1 %}s{% endif %}
          </span>
        </div>
        <div class="listing-controls__pills" role="group" aria-label="Sort products">
          <button type="button"
            class="listing-controls__pill{% if current_sort == 'manual' or current_sort == blank %} is-active{% endif %}"
            data-sort="manual"
            aria-pressed="{% if current_sort == 'manual' or current_sort == blank %}true{% else %}false{% endif %}">
            Featured
          </button>
          <button type="button"
            class="listing-controls__pill{% if current_sort == 'best-selling' %} is-active{% endif %}"
            data-sort="best-selling"
            aria-pressed="{% if current_sort == 'best-selling' %}true{% else %}false{% endif %}">
            Best Selling
          </button>
          <button type="button"
            class="listing-controls__pill{% if current_sort == 'price-ascending' %} is-active{% endif %}"
            data-sort="price-ascending"
            aria-pressed="{% if current_sort == 'price-ascending' %}true{% else %}false{% endif %}">
            Price: Low–High
          </button>
          <button type="button"
            class="listing-controls__pill{% if current_sort == 'price-descending' %} is-active{% endif %}"
            data-sort="price-descending"
            aria-pressed="{% if current_sort == 'price-descending' %}true{% else %}false{% endif %}">
            Price: High–Low
          </button>
          <button type="button"
            class="listing-controls__pill{% if current_sort == 'title-ascending' %} is-active{% endif %}"
            data-sort="title-ascending"
            aria-pressed="{% if current_sort == 'title-ascending' %}true{% else %}false{% endif %}">
            A–Z
          </button>
          <button type="button"
            class="listing-controls__pill{% if current_sort == 'created-descending' %} is-active{% endif %}"
            data-sort="created-descending"
            aria-pressed="{% if current_sort == 'created-descending' %}true{% else %}false{% endif %}">
            Newest
          </button>
        </div>
      </div>

      <div class="collection__grid" id="listing-grid">
        {%- for product in collection.products -%}
          {%- unless product.tags contains 'hidden' -%}
            {%- unless product.metafields.scent_gallery.parent_ml_remaining == 0 -%}
              {%- render 'product-card', product: product -%}
            {%- endunless -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- for product in collection.products -%}
          {%- unless product.tags contains 'hidden' -%}
            {%- if product.metafields.scent_gallery.parent_ml_remaining == 0 -%}
              {%- render 'product-card', product: product -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="collection__load-more">
          {{- paginate | default_pagination -}}
        </div>
      {%- endif -%}

    {%- else -%}
      <div class="listing-empty">
        <p class="listing-empty__title">Nothing here yet.</p>
        <p class="listing-empty__sub">This collection hasn't been stocked yet — check back soon.</p>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var input   = document.getElementById('listing-search');
  var grid    = document.getElementById('listing-grid');
  var countEl = document.getElementById('listing-count');
  if (!input || !grid) return;

  var cards = Array.from(grid.querySelectorAll('.product-card'));
  var names = cards.map(function (c) {
    return ((c.querySelector('.product-card__name') || {}).textContent || '').toLowerCase();
  });
  var total = cards.length;

  // Stagger card entry
  cards.forEach(function (card, i) {
    if (i < 16) card.style.setProperty('--card-delay', (i * 28) + 'ms');
  });

  // Search filter
  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    var visible = 0;
    cards.forEach(function (card, i) {
      var show = !q || names[i].indexOf(q) !== -1;
      card.hidden = !show;
      if (show) visible++;
    });
    if (countEl) {
      countEl.textContent = (q ? visible + ' of ' + total : total) + ' fragrance' + (total === 1 ? '' : 's');
    }
  });

  // Sort pills
  var pills = Array.from(document.querySelectorAll('.listing-controls__pill'));
  pills.forEach(function (pill) {
    pill.addEventListener('click', function () {
      var sortVal = this.dataset.sort;
      // Immediate visual feedback before navigation
      pills.forEach(function (p) {
        p.classList.remove('is-active');
        p.setAttribute('aria-pressed', 'false');
      });
      this.classList.add('is-active');
      this.setAttribute('aria-pressed', 'true');
      // Navigate
      var u = new URL(window.location.href);
      if (sortVal === 'manual') {
        u.searchParams.delete('sort_by');
      } else {
        u.searchParams.set('sort_by', sortVal);
      }
      u.searchParams.delete('page');
      window.location = u.toString();
    });
  });

  // Sticky sentinel
  var sentinel = document.querySelector('.listing-controls-sentinel');
  var controls = document.querySelector('.listing-controls');
  if (sentinel && controls && 'IntersectionObserver' in window) {
    var navOffset = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--space-16') || '64', 10);
    var io = new IntersectionObserver(function (entries) {
      controls.classList.toggle('is-stuck', !entries[0].isIntersecting);
    }, { rootMargin: '-' + navOffset + 'px 0px 0px 0px', threshold: [0, 1] });
    io.observe(sentinel);
  }
}());
</script>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection Grid",
  "tag": "div",
  "settings": [],
  "presets": [
    { "name": "Collection Grid" }
  ]
}
{% endschema %}
