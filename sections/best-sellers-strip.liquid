{%- comment -%}
  Best Sellers teaser strip — stripped 3-card preview between hero and comparison.
  Hand-picked products via theme settings (full editorial control over Mere Exposure).
  Mobile: peek pattern (1.5 cards visible, scroll for more).
  Desktop: 3-up grid, no header, no view-all link.
{%- endcomment -%}

{%- assign has_any = false -%}
{%- for i in (1..3) -%}
  {%- assign key = 'product_' | append: i -%}
  {%- if section.settings[key] != blank -%}{%- assign has_any = true -%}{%- endif -%}
{%- endfor -%}

{%- if has_any -%}
  <section class="bs-strip" aria-label="Featured fragrances">
    <div class="container bs-strip__inner">
      <div class="bs-strip__row" role="list">
        {%- for i in (1..3) -%}
          {%- assign key = 'product_' | append: i -%}
          {%- assign product = section.settings[key] -%}
          {%- if product != blank -%}
            <a href="{{ product.url }}" class="bs-strip__card" role="listitem" aria-label="{{ product.title | escape }}">
              <div class="bs-strip__img-wrap">
                {%- if product.featured_image -%}
                  <img
                    class="bs-strip__img"
                    src="{{ product.featured_image | image_url: width: 360 }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="180"
                    height="240"
                  >
                {%- endif -%}
              </div>
              <p class="bs-strip__name">{{ product.title }}</p>
              <p class="bs-strip__price">from {{ product.price_min | money_without_trailing_zeros }}</p>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Best Sellers Strip",
  "tag": "div",
  "settings": [
    {
      "type": "product",
      "id": "product_1",
      "label": "Card 1 product"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Card 2 product"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Card 3 product"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Strip"
    }
  ]
}
{% endschema %}
