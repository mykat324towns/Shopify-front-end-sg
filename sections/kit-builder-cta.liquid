<section class="kit-builder-cta reveal" aria-label="Build your rotation">
  <div class="container">
    <div class="kit-builder-cta__bottles">
      <div class="kit-builder-cta__bottle kit-builder-cta__bottle--sm">
        <img src="{{ 'bottle-1ml.avif' | asset_url }}" alt="" aria-hidden="true" width="24" height="52">
      </div>
      <div class="kit-builder-cta__bottle kit-builder-cta__bottle--md">
        <img src="{{ 'bottle-2ml.avif' | asset_url }}" alt="" aria-hidden="true" width="32" height="72">
      </div>
      <div class="kit-builder-cta__bottle kit-builder-cta__bottle--lg">
        <img src="{{ 'bottle-5ml.avif' | asset_url }}" alt="" aria-hidden="true" width="40" height="88">
      </div>
      <div class="kit-builder-cta__bottle kit-builder-cta__bottle--md">
        <img src="{{ 'bottle-10ml.avif' | asset_url }}" alt="" aria-hidden="true" width="32" height="72">
      </div>
      <div class="kit-builder-cta__bottle kit-builder-cta__bottle--sm">
        <img src="{{ 'bottle-30ml.avif' | asset_url }}" alt="" aria-hidden="true" width="24" height="52">
      </div>
    </div>

    <p class="kit-builder-cta__overline">{{ section.settings.overline }}</p>
    <h2 class="kit-builder-cta__headline">{{ section.settings.headline }}</h2>
    <p class="kit-builder-cta__sub">{{ section.settings.subtext }}</p>
    {%- if section.settings.trust_cue != blank -%}
      <div class="cta-trust-cue-line">
        {%- render 'cta-trust-cue', icon: 'shield', label: section.settings.trust_cue -%}
      </div>
    {%- endif -%}
    <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_text }}</a>
    <div class="kit-cta__trust">
      {%- render 'cta-trust-cue', label: '', payment_marks: 'apple_pay,shop_pay' -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kit Builder CTA",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Build it your way."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Build Your Rotation"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Pick your sizes. Stack the ones you've been meaning to try. Ship one box, one tracking number."
    },
    {
      "type": "text",
      "id": "trust_cue",
      "label": "Inline trust cue (above CTA)",
      "info": "Small uppercase microbadge that primes the click. Keep short.",
      "default": "100% authentic · Hand-packed in AZ"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Start Building →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "info": "Replaced by hardcoded Apple Pay + Shop Pay payment marks in the section render — leaving here for compatibility."
    }
  ],
  "presets": [
    {
      "name": "Kit Builder CTA"
    }
  ]
}
{% endschema %}
