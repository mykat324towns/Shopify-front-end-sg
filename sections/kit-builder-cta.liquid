<section class="kit-builder-cta reveal" aria-label="Build your rotation">
  <div class="container">
    <div class="kit-builder-cta__bottles">
      {%- if section.settings.bottle_1ml != blank -%}
        <div class="kit-builder-cta__bottle kit-builder-cta__bottle--sm">
          <img src="{{ section.settings.bottle_1ml | image_url: width: 80 }}" alt="" aria-hidden="true" width="40">
        </div>
      {%- endif -%}
      {%- if section.settings.bottle_2ml != blank -%}
        <div class="kit-builder-cta__bottle kit-builder-cta__bottle--md">
          <img src="{{ section.settings.bottle_2ml | image_url: width: 104 }}" alt="" aria-hidden="true" width="52">
        </div>
      {%- endif -%}
      {%- if section.settings.bottle_5ml != blank -%}
        <div class="kit-builder-cta__bottle kit-builder-cta__bottle--lg">
          <img src="{{ section.settings.bottle_5ml | image_url: width: 128 }}" alt="" aria-hidden="true" width="64">
        </div>
      {%- endif -%}
      {%- if section.settings.bottle_10ml != blank -%}
        <div class="kit-builder-cta__bottle kit-builder-cta__bottle--md">
          <img src="{{ section.settings.bottle_10ml | image_url: width: 104 }}" alt="" aria-hidden="true" width="52">
        </div>
      {%- endif -%}
      {%- if section.settings.bottle_30ml != blank -%}
        <div class="kit-builder-cta__bottle kit-builder-cta__bottle--sm">
          <img src="{{ section.settings.bottle_30ml | image_url: width: 80 }}" alt="" aria-hidden="true" width="40">
        </div>
      {%- endif -%}
    </div>

    <p class="kit-builder-cta__overline">{{ section.settings.overline }}</p>
    <h2 class="kit-builder-cta__headline">{{ section.settings.headline }}</h2>
    <p class="kit-builder-cta__sub">{{ section.settings.subtext }}</p>
    <a href="{{ section.settings.cta_url }}" class="btn-primary">{{ section.settings.cta_text }}</a>
    <p class="kit-cta__trust">{{ section.settings.trust_line }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Kit Builder CTA",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Don't commit. Rotate."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Build Your Rotation"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Add the ones you've been putting off. Try ten for less than one bottle. We pack and ship in days."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Start Building →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Trust line",
      "default": "100% authentic · Ships in 1–2 days · From $4"
    },
    {
      "type": "image_picker",
      "id": "bottle_1ml",
      "label": "1ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "bottle_2ml",
      "label": "2ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "bottle_5ml",
      "label": "5ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "bottle_10ml",
      "label": "10ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "bottle_30ml",
      "label": "30ml bottle image"
    }
  ],
  "presets": [
    {
      "name": "Kit Builder CTA"
    }
  ]
}
{% endschema %}
