{%- assign gallery_fallback = 'bottle-10ml.avif' -%}
{%- for _v in product.variants -%}
  {%- unless _v.option1 contains '+' -%}
    {%- assign _fs = _v.option1 | downcase -%}
    {%- if _fs == '1ml' -%}{%- assign gallery_fallback = 'bottle-1ml.avif' -%}
    {%- elsif _fs == '2ml' -%}{%- assign gallery_fallback = 'bottle-2ml.avif' -%}
    {%- elsif _fs == '5ml' -%}{%- assign gallery_fallback = 'bottle-5ml.avif' -%}
    {%- elsif _fs == '10ml' -%}{%- assign gallery_fallback = 'bottle-10ml.avif' -%}
    {%- elsif _fs == '30ml' -%}{%- assign gallery_fallback = 'bottle-30ml.avif' -%}
    {%- endif -%}
    {%- break -%}
  {%- endunless -%}
{%- endfor -%}

<div class="container" id="product-content">

  <nav class="product-breadcrumb" aria-label="Breadcrumb">
    <a class="product-breadcrumb__link" href="{{ product.collections.first.url | default: '/collections/all' }}">
      ← {{ product.collections.first.title | default: 'Shop' }}
    </a>
  </nav>

  <div class="product-layout">

    <!-- ── Gallery ── -->
    <div class="product-gallery">
      <div class="product-gallery__viewer product-gallery__viewer--solo" id="product-gallery-viewer">
        <div class="product-gallery__main">
          {%- if product.featured_image -%}
            <img
              id="product-gallery-main-img"
              src="{{ product.featured_image | image_url: width: 600 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- else -%}
            <img
              id="product-gallery-main-img"
              src="{{ gallery_fallback | asset_url }}"
              alt="{{ product.title | escape }}"
              loading="eager"
              fetchpriority="high"
            >
          {%- endif -%}
        </div>
        <div class="product-gallery__variant" id="product-gallery-variant">
          <span class="product-gallery__variant-badge" aria-hidden="true">Premium</span>
          <img
            id="product-gallery-variant-img"
            alt=""
            loading="lazy"
            style="display:none"
          >
        </div>
      </div>
    </div>

    <!-- ── Details ── -->
    <div class="product-details">

      <h1 class="product-name">{{ product.title }}</h1>

      <p class="product-price" id="product-price" aria-live="polite">
        {{- product.variants.first.price | money -}}
      </p>
      {%- assign retail_price_text = product.metafields.custom.retail_price.value -%}
      {%- if retail_price_text != blank -%}
        <p class="pdp-retail-anchor">Full bottle: <del>{{ retail_price_text }}</del></p>
      {%- endif -%}

      <!-- Scent notes -->
      {%- assign scent_notes  = product.metafields.custom.scent_notes.value -%}
      {%- assign scent_body   = product.metafields.custom.description_body.value -%}
      {%- assign scent_bestfor = product.metafields.custom.best_for.value -%}
      {%- assign has_scent_content = false -%}
      {%- if scent_notes != blank or scent_body != blank or product.description != blank -%}
        {%- assign has_scent_content = true -%}
      {%- endif -%}

      {%- if has_scent_content -%}
        <div class="scent-toggle" id="scent-toggle">
          <button
            class="scent-toggle__trigger"
            aria-expanded="false"
            aria-controls="scent-toggle-body"
          >
            Scent Notes
            <span class="scent-toggle__chevron" aria-hidden="true"></span>
          </button>
          <div class="scent-toggle__body" id="scent-toggle-body">
            {%- if scent_notes != blank -%}
              <div class="scent-toggle__section scent-toggle__section--notes">
                {%- assign notes_array = scent_notes | split: ',' -%}
                {%- for note in notes_array -%}
                  <span class="scent-note">{{ note | strip }}</span>
                {%- endfor -%}
              </div>
            {%- endif -%}
            {%- if scent_body != blank -%}
              <div class="scent-toggle__section scent-toggle__section--body">
                <p class="scent-toggle__desc">{{ scent_body }}</p>
              </div>
            {%- elsif product.description != blank -%}
              <div class="scent-toggle__section scent-toggle__section--body">
                <p class="scent-toggle__desc">{{ product.description | strip_html }}</p>
              </div>
            {%- endif -%}
            {%- if scent_bestfor != blank -%}
              <div class="scent-toggle__section scent-toggle__section--bestfor">
                <p class="scent-toggle__bestfor-text">
                  <span class="scent-toggle__bestfor-label">Best for:</span>{{ scent_bestfor }}
                </p>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      <!-- Size selector — base variants only (no "+" pressurized) -->
      <div id="size-selector-mount">
        <div class="size-selector">
          <p class="size-selector__label">Select Size</p>
          <div class="size-selector-grid" role="group" aria-label="Select a size">
            {%- for variant in product.variants -%}
              {%- unless variant.option1 contains '+' -%}
                {%- assign v_size = variant.option1 | downcase -%}
                {%- if v_size == '1ml' -%}{%- assign v_bottle = 'bottle-1ml.avif' -%}
                {%- elsif v_size == '2ml' -%}{%- assign v_bottle = 'bottle-2ml.avif' -%}
                {%- elsif v_size == '5ml' -%}{%- assign v_bottle = 'bottle-5ml.avif' -%}
                {%- elsif v_size == '10ml' -%}{%- assign v_bottle = 'bottle-10ml.avif' -%}
                {%- elsif v_size == '30ml' -%}{%- assign v_bottle = 'bottle-30ml.avif' -%}
                {%- else -%}{%- assign v_bottle = 'bottle-10ml.avif' -%}
                {%- endif -%}
                <button
                  class="size-card"
                  type="button"
                  data-variant-id="{{ variant.id }}"
                  data-size="{{ variant.option1 | downcase }}"
                  data-price="{{ variant.price }}"
                  data-available="{{ variant.available }}"
                  data-ml="{{ variant.metafields.scent_gallery.ml_size | default: 0 }}"
                  data-bottle="{{ v_bottle | asset_url }}"
                  aria-pressed="false"
                >
                  {%- if variant.featured_image -%}
                    <img
                      class="size-card__img"
                      src="{{ variant.featured_image | image_url: width: 80 }}"
                      alt="{{ variant.option1 }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      class="size-card__img"
                      src="{{ v_bottle | asset_url }}"
                      alt="{{ variant.option1 }}"
                      loading="lazy"
                    >
                  {%- endif -%}
                  <span class="size-card__label">{{ variant.option1 }}</span>
                  {%- assign spray_val = variant.metafields.custom.sprays.value -%}
                  {%- if spray_val != blank -%}
                    <span class="size-card__sub">~{{ spray_val }} sprays</span>
                  {%- endif -%}
                  <span class="size-card__price">{{ variant.price | money }}</span>
                  {%- assign badge_val = variant.metafields.custom.size_label.value -%}
                  {%- if badge_val != blank -%}
                    <span class="size-card__badge">{{ badge_val }}</span>
                  {%- endif -%}
                </button>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      </div>

      <!-- Parent ML stock indicator — urgency-tiered scarcity signal -->
      {%- assign parent_ml = product.metafields.scent_gallery.parent_ml_remaining -%}
      {%- if parent_ml != blank and parent_ml > 0 -%}
        {%- assign ml_rounded = parent_ml | round: 1 -%}
        {%- if parent_ml <= 15 -%}
          {%- assign scarcity_level = 'critical' -%}
          {%- assign scarcity_copy = 'Only ' | append: ml_rounded | append: 'ml left — last of this bottle.' -%}
        {%- elsif parent_ml <= 40 -%}
          {%- assign scarcity_level = 'low' -%}
          {%- assign scarcity_copy = 'Only ' | append: ml_rounded | append: 'ml left from this bottle.' -%}
        {%- else -%}
          {%- assign scarcity_level = 'normal' -%}
          {%- assign scarcity_copy = ml_rounded | append: 'ml remaining from this bottle.' -%}
        {%- endif -%}
        <p class="pdp-scarcity-badge sg-stock-remaining sg-stock-remaining--{{ scarcity_level }}" data-parent-ml="{{ parent_ml }}">
          <span class="pdp-scarcity-dot" aria-hidden="true"></span>
          {{ scarcity_copy }}
        </p>
      {%- elsif parent_ml == 0 -%}
        <p class="pdp-scarcity-badge pdp-scarcity-badge--out sg-stock-remaining sg-stock-remaining--out">
          <span class="pdp-scarcity-dot pdp-scarcity-dot--out" aria-hidden="true"></span>
          Sold out — next batch coming soon
        </p>
      {%- endif -%}

      <!-- Pressurized toggle — revealed by JS when applicable.
           data-press-bottles is a JSON map of base-size → pressurized bottle asset URL. -->
      <div class="pressurized-toggle" id="pressurized-toggle" aria-hidden="true"
           data-press-bottles='{"10ml":"{{ 'bottle-10ml-pressurized.avif' | asset_url }}","30ml":"{{ 'bottle-30ml-pressurized.avif' | asset_url }}"}'>
        <div class="pressurized-toggle__inner">
          <div class="pressurized-toggle__info">
            <span class="pressurized-toggle__name">Pressurized Bottle</span>
            <span class="pressurized-toggle__sub">Finer mist &middot; ~<span id="pressurized-sprays"></span> sprays</span>
          </div>
          <div class="pressurized-toggle__right">
            <span class="pressurized-toggle__price" id="pressurized-price"></span>
            <button
              class="pressurized-toggle__btn"
              id="pressurized-btn"
              type="button"
              aria-pressed="false"
              aria-label="Upgrade to pressurized bottle"
            >
              <span class="pressurized-toggle__track">
                <span class="pressurized-toggle__thumb-pill"></span>
              </span>
            </button>
          </div>
        </div>
      </div>

      <!-- Pre-ATC trust stack: review microbadge (conditional) + inline trust cue -->
      {%- assign rating = product.metafields.reviews.rating.value -%}
      {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
      {%- if rating != blank and rating_count >= 5 -%}
        <div class="pdp-review-cue" aria-label="{{ rating }} stars from {{ rating_count }} reviews">
          <span class="pdp-review-cue__stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              {%- if i <= rating -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" style="opacity:0.25"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </span>
          <span class="pdp-review-cue__rating">{{ rating }}</span>
          <span class="pdp-review-cue__count">· {{ rating_count }} review{% if rating_count != 1 %}s{% endif %}</span>
        </div>
      {%- endif -%}

      <div class="cta-trust-cue-line">
        {%- render 'cta-trust-cue', icon: 'shield', label: '100% authentic', payment_marks: 'apple_pay,shop_pay' -%}
      </div>

      <!-- Add to cart -->
      <div class="product-actions">
        <form id="product-form" method="post" action="/cart/add">
          <input type="hidden" name="id" id="selected-variant-id" value="{{ product.variants.first.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            class="btn-add-to-cart"
            type="submit"
            id="btn-add-to-cart"
            disabled
          >Select a Size</button>
        </form>
      </div>

      <!-- Trust strip -->
      <div class="product-trust" aria-label="Purchase guarantees">
        <div class="product-trust__item">
          <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          <span class="product-trust__label">100% Authentic</span>
          <span class="product-trust__sub">Poured from real bottles</span>
        </div>
        <div class="product-trust__item">
          <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z"/><path d="M3 7l9 4 9-4M12 11v10"/></svg>
          <span class="product-trust__label">Ships 1–2 Days</span>
          <span class="product-trust__sub">Hand-packed in AZ</span>
        </div>
        <div class="product-trust__item">
          <svg class="product-trust__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 12a9 9 0 1115.59 6.34M21 12a9 9 0 01-15.59-6.34"/><path d="M3 12V7M21 12v5"/></svg>
          <span class="product-trust__label">Free Returns</span>
          <span class="product-trust__sub">If something's off, we replace it</span>
        </div>
      </div>

    </div><!-- .product-details -->
  </div><!-- .product-layout -->

  <!-- Social Proof Swiper — admin-uploaded blocks take priority; falls back to bundled comment-NN.png assets -->
  {%- assign has_blocks = false -%}
  {%- if section.blocks.size > 0 -%}{%- assign has_blocks = true -%}{%- endif -%}
  {%- assign asset_count = section.settings.asset_image_count | default: 12 -%}

  {%- if has_blocks or asset_count > 0 -%}
    <div class="social-proof">
      <div class="social-proof__header">
        <svg class="social-proof__tiktok-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.81a8.18 8.18 0 004.78 1.52V6.88a4.85 4.85 0 01-1.01-.19z"/>
        </svg>
        <div>
          <span class="social-proof__overline">{{ section.settings.social_overline | default: 'From the @scentgallery_ TikTok community' }}</span>
          <h2 class="social-proof__title">{{ section.settings.social_title | default: 'As seen on TikTok' }}</h2>
          <p class="social-proof__sub">{{ section.settings.social_sub | default: 'Real reactions from real collectors.' }}</p>
        </div>
      </div>
      <div class="swiper social-proof-swiper" id="social-proof-swiper">
        <div class="swiper-wrapper">
          {%- if has_blocks -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'social_image' and block.settings.image != blank -%}
                <div class="swiper-slide social-proof__slide" {{ block.shopify_attributes }}>
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    alt="{{ block.settings.caption | default: 'Customer review' | escape }}"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..asset_count) -%}
              {%- assign n = i | prepend: '0' | slice: -2, 2 -%}
              {%- assign cname = 'comment-' | append: n -%}
              <div class="swiper-slide social-proof__slide">
                {% render 'picture-asset', filename: cname, alt: 'Customer comment screenshot', loading: 'lazy' %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        <div class="swiper-pagination social-proof__pagination"></div>
      </div>
    </div>
  {%- endif -%}

</div>

<!-- Sticky Add-to-Cart bar — mobile only, appears after size selection -->
<div class="sticky-atc" id="sticky-atc" aria-hidden="true">
  <img
    class="sticky-atc__thumb"
    id="sticky-atc-thumb"
    src="{{ product.featured_image | image_url: width: 48 }}"
    alt="{{ product.title | escape }}"
    loading="eager"
    width="24"
    height="24"
  >
  <span class="sticky-atc__name">{{ product.title | escape }}</span>
  <span class="sticky-atc__price" id="sticky-atc-price"></span>
  <button class="sticky-atc__btn" id="sticky-atc-btn" type="button">Add to Rotation</button>
</div>

<!-- Variant data for product-page.js -->
<script>
window.SG_VARIANTS = {{ product.variants | json }};
window.SG_PARENT_ML = {{ product.metafields.scent_gallery.parent_ml_remaining | default: 'null' }};
{%- assign cs = section.settings.cross_sell_product -%}
{%- if cs != blank -%}
window.SG_CROSS_SELL = {
  variantId: {{ cs.variants.first.id | json }},
  title: {{ cs.title | json }},
  price: {{ cs.variants.first.price | json }},
  image: {{ cs.featured_image | image_url: width: 120 | json }},
  url: {{ cs.url | json }}
};
{%- else -%}
window.SG_CROSS_SELL = null;
{%- endif -%}
{%- if product.metafields.scent_gallery.bundle_component_ids -%}
window.SG_BUNDLE_COMPONENT_REMAINING = [{%- for ref in product.metafields.scent_gallery.bundle_component_ids.value -%}{{ ref.metafields.scent_gallery.parent_ml_remaining | default: 'null' }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}];
{%- endif -%}
{%- assign upgrade = all_products['pressurized-atomizer-upgrade'] -%}
{%- if upgrade != blank and upgrade.variants.first != blank -%}
window.SG_PRESSURIZED_UPGRADE = {
  variantId: {{ upgrade.variants.first.id | json }},
  price: {{ upgrade.variants.first.price | json }},
  available: {{ upgrade.variants.first.available | json }}
};
{%- endif -%}
</script>

{%- render 'cross-sell-modal' -%}

<script src="{{ 'product-page.js' | asset_url }}" defer></script>
<script src="{{ 'sticky-atc.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product Main",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "social_overline",
      "label": "Social proof overline",
      "default": "From the @scentgallery_ TikTok community"
    },
    {
      "type": "text",
      "id": "social_title",
      "label": "Social proof heading",
      "default": "As seen on TikTok"
    },
    {
      "type": "text",
      "id": "social_sub",
      "label": "Social proof subtext",
      "default": "Real reactions from real collectors."
    },
    {
      "type": "range",
      "id": "asset_image_count",
      "label": "Bundled comment screenshots to show",
      "info": "Renders comment-01.png through comment-NN.png from theme assets when no admin blocks are uploaded.",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "product",
      "id": "cross_sell_product",
      "label": "Cart upsell product",
      "info": "When set, a bottom sheet fires after Add to Cart offering this product. Leave blank to disable."
    }
  ],
  "blocks": [
    {
      "type": "social_image",
      "name": "Social Proof Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (TikTok screenshot, review, etc.)"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Alt text / caption"
        }
      ]
    }
  ],
  "presets": [
    { "name": "Product Main" }
  ]
}
{% endschema %}
