<section class="cta-section" aria-label="{{ section.settings.title | escape }}">
  <div class="container">
    <p class="cta-section__overline">{{ section.settings.overline }}</p>
    <h2 class="cta-section__title">{{ section.settings.title }}</h2>
    <p class="cta-section__body">{{ section.settings.body }}</p>
    {%- if section.settings.trust_cue != blank -%}
      <div class="cta-trust-cue-line">
        {%- render 'cta-trust-cue', icon: 'shield', label: section.settings.trust_cue, payment_marks: 'apple_pay,shop_pay' -%}
      </div>
    {%- endif -%}
    <div class="cta-section__actions">
      {%- if section.settings.cta_primary_text != blank -%}
        <a href="{{ section.settings.cta_primary_url }}" class="btn-primary--white">{{ section.settings.cta_primary_text }}</a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_text != blank -%}
        <a href="{{ section.settings.cta_secondary_url }}" class="btn-ghost--white">{{ section.settings.cta_secondary_text }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.reassurance != blank -%}
      <span class="cta-trust-reassurance">{{ section.settings.reassurance }}</span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "CTA Section",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Last call."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Your signature is in there somewhere."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "One of them is the one you'll wear out. The rest live in the rotation. From $4 to find out."
    },
    {
      "type": "text",
      "id": "trust_cue",
      "label": "Inline trust cue (above CTAs)",
      "info": "Small uppercase microbadge that primes the click. Keep short.",
      "default": "100% authentic"
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA text",
      "default": "Browse Best Sellers"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA text",
      "default": "See all sizes →"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line (below CTAs)",
      "info": "Italic, soft. Optional.",
      "default": "Free U.S. shipping over $35 · Hand-packed in AZ"
    }
  ],
  "presets": [
    {
      "name": "CTA Section"
    }
  ]
}
{% endschema %}
