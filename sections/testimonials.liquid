{%- capture star_svg -%}<svg class="star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{%- endcapture -%}

<section class="testimonials" aria-label="Customer reviews">
  <div class="container">
    <div class="testimonials__with-photo">
      <div class="testimonials__cards-wrap">
        <header class="testimonials__header reveal">
          <span class="testimonials__overline">{{ section.settings.overline }}</span>
          <h2 class="testimonials__title">{{ section.settings.title }}</h2>
        </header>

        <div class="testimonials__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'testimonial' -%}
              <article class="testimonial-card reveal" {% if forloop.index > 1 %}style="transition-delay:{{ forloop.index0 | times: 80 }}ms"{% endif %} {{ block.shopify_attributes }}>
                <span class="testimonial-card__quote-mark" aria-hidden="true">"</span>
                <div class="testimonial-card__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    {%- if i <= block.settings.stars -%}
                      {{ star_svg }}
                    {%- else -%}
                      <svg class="star star--empty" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <blockquote class="testimonial-card__quote">{{ block.settings.quote }}</blockquote>
                <footer class="testimonial-card__attribution">
                  <div class="testimonial-card__avatar">{{ block.settings.initials }}</div>
                  <div class="testimonial-card__name">{{ block.settings.name }}</div>
                </footer>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="testimonials__photo-placeholder" id="box-panel">
        {%- if section.settings.photo != blank -%}
          <img
            class="testimonials__order-photo"
            src="{{ section.settings.photo | image_url: width: 800 }}"
            alt="{{ section.settings.photo.alt | default: 'Scent Gallery order' | escape }}"
            loading="lazy"
            width="673"
            height="636"
          >
        {%- else -%}
          <img
            class="testimonials__order-photo"
            src="{{ 'full-box.png' | asset_url }}"
            alt="Scent Gallery luxury order — sealed shipping box ready for dispatch"
            loading="lazy"
            width="673"
            height="636"
          >
        {%- endif -%}

        <button
          class="witb__toggle"
          id="witb-toggle"
          aria-expanded="false"
          aria-controls="witb-diagram"
          type="button"
        >
          <span class="witb__toggle-text">What shows up at your door</span>
          <svg class="witb__toggle-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <polyline points="4,6 8,10 12,6" stroke="currentColor" stroke-width="2"
              stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
        </button>

        <div class="witb__diagram-outer" id="witb-diagram" role="region" aria-label="Box contents">
          <div class="witb__diagram-inner">

            <div class="witb__section">
              <span class="witb__section-label">Packaging</span>
              <div class="witb__grid witb__grid--packaging">
                <div class="witb__item" style="--item-delay:0ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bubble-mailer.png' | asset_url }}" alt="Bubble Mailer" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">Bubble Mailer</span>
                </div>
                <div class="witb__item" style="--item-delay:60ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'stretch-wrap.png' | asset_url }}" alt="Stretch Wrap" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">Stretch Wrap</span>
                </div>
              </div>
            </div>

            <div class="witb__section">
              <span class="witb__section-label">Bottles</span>
              <div class="witb__grid witb__grid--bottles">
                <div class="witb__item" style="--item-delay:120ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-1ml.avif' | asset_url }}" alt="1 ml bottle" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">1 ml</span>
                </div>
                <div class="witb__item" style="--item-delay:175ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-2ml.avif' | asset_url }}" alt="2 ml bottle" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">2 ml</span>
                </div>
                <div class="witb__item" style="--item-delay:230ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-5ml.avif' | asset_url }}" alt="5 ml bottle" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">5 ml</span>
                </div>
                <div class="witb__item" style="--item-delay:285ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-10ml.avif' | asset_url }}" alt="10 ml bottle" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">10 ml</span>
                </div>
                <div class="witb__item" style="--item-delay:340ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-30ml.avif' | asset_url }}" alt="30 ml bottle" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">30 ml</span>
                </div>
                <div class="witb__item" style="--item-delay:395ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-10ml-pressurized.avif' | asset_url }}" alt="10 ml pressurized" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">10 ml Pressurized</span>
                </div>
                <div class="witb__item" style="--item-delay:450ms">
                  <div class="witb__item-img-wrap">
                    <img src="{{ 'bottle-30ml-pressurized.avif' | asset_url }}" alt="30 ml pressurized" loading="lazy" class="witb__item-img">
                  </div>
                  <span class="witb__item-label">30 ml Pressurized</span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "From people who wear these"
    },
    {
      "type": "image_picker",
      "id": "photo",
      "label": "Side photo (order/packaging)"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "initials",
          "label": "Initials (2 letters)",
          "info": "Shown in avatar circle"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Ordered 6 scents for $42. Found my new signature. Never would've known without trying it first.",
            "name": "Marcus T.",
            "initials": "MT",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Packaging was surprisingly good. Nothing leaked, everything sealed. Arrived fast.",
            "name": "Jacob L.",
            "initials": "JL",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "I was skeptical about decants. Not anymore. The 5ml lasted me two full weeks.",
            "name": "Logan M.",
            "initials": "LM",
            "stars": 5
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Stopped buying blind after this. My rotation is actually good now.",
            "name": "Derek S.",
            "initials": "DS",
            "stars": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
