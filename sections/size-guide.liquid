<section class="size-guide" aria-label="Size comparison">
  <div class="container">
    <div class="size-guide__header">
      <h2 class="size-guide__title">{{ section.settings.title }}</h2>
      <p class="size-guide__sub">{{ section.settings.subtitle }}</p>
    </div>
    <div class="size-guide__row">

      {%- if section.settings.image_1ml != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_1ml | image_url: width: 120 }}" alt="1ml decant bottle" loading="lazy">
          <span class="size-guide__label">1ml</span>
          <span class="size-guide__price">~18 sprays</span>
        </div>
      {%- endif -%}

      {%- if section.settings.image_2ml != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_2ml | image_url: width: 120 }}" alt="2ml decant bottle" loading="lazy">
          <span class="size-guide__label">2ml</span>
          <span class="size-guide__price">~36 sprays</span>
        </div>
      {%- endif -%}

      {%- if section.settings.image_5ml != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_5ml | image_url: width: 120 }}" alt="5ml decant bottle" loading="lazy">
          <span class="size-guide__label">5ml</span>
          <span class="size-guide__price">~90 sprays</span>
        </div>
      {%- endif -%}

      {%- if section.settings.image_10ml != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_10ml | image_url: width: 120 }}" alt="10ml decant bottle" loading="lazy">
          <span class="size-guide__label">10ml</span>
          <span class="size-guide__price">~180 sprays</span>
        </div>
      {%- endif -%}

      {%- if section.settings.image_10ml_p != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_10ml_p | image_url: width: 120 }}" alt="10ml pressurized decant bottle" loading="lazy">
          <span class="size-guide__label">10ml</span>
          <span class="size-guide__type">Pressurized</span>
          <span class="size-guide__price">~130 sprays</span>
        </div>
      {%- endif -%}

      {%- if section.settings.image_30ml != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_30ml | image_url: width: 120 }}" alt="30ml decant bottle" loading="lazy">
          <span class="size-guide__label">30ml</span>
          <span class="size-guide__price">~540 sprays</span>
        </div>
      {%- endif -%}

      {%- if section.settings.image_30ml_p != blank -%}
        <div class="size-guide__item">
          <img src="{{ section.settings.image_30ml_p | image_url: width: 120 }}" alt="30ml pressurized decant bottle" loading="lazy">
          <span class="size-guide__label">30ml</span>
          <span class="size-guide__type">Pressurized</span>
          <span class="size-guide__price">~390 sprays</span>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size Guide",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Every size. Your choice."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "From a quick test to a full rotation. All extracted from authentic bottles."
    },
    {
      "type": "image_picker",
      "id": "image_1ml",
      "label": "1ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "image_2ml",
      "label": "2ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "image_5ml",
      "label": "5ml bottle image"
    },
    {
      "type": "image_picker",
      "id": "image_10ml",
      "label": "10ml basic bottle image"
    },
    {
      "type": "image_picker",
      "id": "image_10ml_p",
      "label": "10ml pressurized bottle image"
    },
    {
      "type": "image_picker",
      "id": "image_30ml",
      "label": "30ml basic bottle image"
    },
    {
      "type": "image_picker",
      "id": "image_30ml_p",
      "label": "30ml pressurized bottle image"
    }
  ],
  "presets": [
    {
      "name": "Size Guide"
    }
  ]
}
{% endschema %}
