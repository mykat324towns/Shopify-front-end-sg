<section class="size-guide" aria-label="Size comparison">
  <div class="container">
    <div class="size-guide__header">
      <h2 class="size-guide__title">{{ section.settings.title }}</h2>
      <p class="size-guide__sub">{{ section.settings.subtitle }}</p>
    </div>
    <div class="size-guide__row">

      <div class="size-guide__item">
        <img src="{{ 'bottle-1ml.avif' | asset_url }}" alt="1ml decant bottle" loading="lazy" width="24" height="48">
        <span class="size-guide__label">1ml</span>
        <span class="size-guide__price">~18 sprays</span>
      </div>

      <div class="size-guide__item">
        <img src="{{ 'bottle-2ml.avif' | asset_url }}" alt="2ml decant bottle" loading="lazy" width="30" height="64">
        <span class="size-guide__label">2ml</span>
        <span class="size-guide__price">~36 sprays</span>
      </div>

      <div class="size-guide__item size-guide__item--recommended">
        <span class="size-guide__tag">Recommended start</span>
        <img src="{{ 'bottle-5ml.avif' | asset_url }}" alt="5ml decant bottle" loading="lazy" width="38" height="82">
        <span class="size-guide__label">5ml</span>
        <span class="size-guide__price">~90 sprays</span>
      </div>

      <div class="size-guide__item">
        <img src="{{ 'bottle-10ml.avif' | asset_url }}" alt="10ml decant bottle" loading="lazy" width="46" height="100">
        <span class="size-guide__label">10ml</span>
        <span class="size-guide__price">~180 sprays</span>
      </div>

      <div class="size-guide__item">
        <img src="{{ 'bottle-10ml-pressurized.avif' | asset_url }}" alt="10ml pressurized decant bottle" loading="lazy" width="50" height="108">
        <span class="size-guide__label">10ml</span>
        <span class="size-guide__type">Pressurized</span>
        <span class="size-guide__price">~130 sprays</span>
      </div>

      <div class="size-guide__item">
        <img src="{{ 'bottle-30ml.avif' | asset_url }}" alt="30ml decant bottle" loading="lazy" width="58" height="128">
        <span class="size-guide__label">30ml</span>
        <span class="size-guide__price">~540 sprays</span>
      </div>

      <div class="size-guide__item">
        <img src="{{ 'bottle-30ml-pressurized.avif' | asset_url }}" alt="30ml pressurized decant bottle" loading="lazy" width="64" height="140">
        <span class="size-guide__label">30ml</span>
        <span class="size-guide__type">Pressurized</span>
        <span class="size-guide__price">~390 sprays</span>
      </div>

    </div>
    <div class="size-guide__footer">
      <a href="#shopify-section-faq" class="size-guide__see-all">See all sizes →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Size Guide",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Pick your test size."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Start with 5ml — about two weeks of daily wear. Upgrade once you find the one."
    }
  ],
  "presets": [
    {
      "name": "Size Guide"
    }
  ]
}
{% endschema %}
