<section class="hero" aria-label="Hero" id="hero">
  <div class="hero__sidebar" aria-hidden="true">
    <span class="hero__sidebar-text">{{ section.settings.sidebar_text }}</span>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <span class="hero__overline">{{ section.settings.overline }}</span>
      <h1 class="hero__headline">{{ section.settings.headline }}</h1>
      <p class="hero__sub">{{ section.settings.subtext }}</p>

      {%- if section.settings.proof_text != blank -%}
        <p class="hero__proof hero__proof--text">{{ section.settings.proof_text }}</p>
      {%- elsif section.settings.proof_count != blank -%}
        <div class="hero__proof">
          <span class="hero__proof-num" id="hero-order-count">{{ section.settings.proof_count }}</span>
          <span class="hero__proof-label">orders packed</span>
        </div>
      {%- endif -%}

      <div class="hero__actions">
        <a href="{{ section.settings.cta_primary_url }}" class="btn-primary">{{ section.settings.cta_primary_text }}</a>
        <a href="{{ section.settings.cta_secondary_url }}" class="btn-ghost">{{ section.settings.cta_secondary_text }}</a>
      </div>

      <div class="hero__trust" aria-label="Trust signals">
        <span class="hero__trust-item">{{ section.settings.trust_1 }}</span>
        <span class="hero__trust-sep" aria-hidden="true">·</span>
        <span class="hero__trust-item">{{ section.settings.trust_2 }}</span>
        <span class="hero__trust-sep" aria-hidden="true">·</span>
        <span class="hero__trust-item">{{ section.settings.trust_3 }}</span>
      </div>
    </div>

    <div class="hero__media">
      {%- if section.settings.video != blank -%}
        <video
          class="hero__video"
          src="{{ section.settings.video }}"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          fetchpriority="high"
          aria-label="Scent Gallery order packing video"
        ></video>
      {%- elsif section.settings.image != blank -%}
        <img
          class="hero__video"
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image.alt | default: 'Scent Gallery' | escape }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <video
          class="hero__video"
          src="{{ 'hero-video.mp4' | asset_url }}"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          fetchpriority="high"
          aria-label="Scent Gallery order packing video"
        ></video>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Authentic. Decanted. From $4."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Ten scents.<br>One bottle's price."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Decants from $4. Skip the $300 blind-buy regret. Try ten before you commit to one."
    },
    {
      "type": "text",
      "id": "proof_text",
      "label": "Proof line (authority/curation statement)",
      "info": "Use this for a static authority statement (e.g. founder/curation/authenticity). Leave the orders-packed count below blank if this is set.",
      "default": "Hand-poured in Arizona. Authentic-only — no clones, no dupes, no oils."
    },
    {
      "type": "number",
      "id": "proof_count",
      "label": "Orders packed count (fallback only)",
      "info": "Renders only if the proof line above is empty. Don't surface a static number unless it's a live counter."
    },
    {
      "type": "text",
      "id": "cta_primary_text",
      "label": "Primary CTA text",
      "default": "Browse Best Sellers"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_text",
      "label": "Secondary CTA text",
      "default": "How it works →"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "info": "Keep short — trust strip stays horizontal on mobile.",
      "default": "100% authentic"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "Ships 1–2 days"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "Hand-packed in AZ"
    },
    {
      "type": "text",
      "id": "sidebar_text",
      "label": "Sidebar rotated text",
      "default": "Decants · Try before you commit"
    },
    {
      "type": "text",
      "id": "video",
      "label": "Hero video URL",
      "info": "Upload an .mp4 to Shopify Admin → Content → Files, then paste the URL here."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (fallback if no video)"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
