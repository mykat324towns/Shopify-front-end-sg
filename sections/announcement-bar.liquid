{% if section.settings.text != blank %}
  <div
    id="announcement-bar"
    class="announcement-bar"
    data-section-id="{{ section.id }}"
  >
    <div class="container announcement-bar__inner">
      <p class="announcement-bar__text">{{ section.settings.text }}</p>
      {% if section.settings.dismissible %}
        <button class="announcement-bar__dismiss" aria-label="Dismiss announcement">&#x2715;</button>
      {% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "info": "Rotate weekly. Suggested options: \"Free U.S. shipping over $35. Most orders ship next-day.\" / \"Hand-poured from authentic bottles. Free shipping over $35.\" / Real low-stock alerts only: \"Last 18ml left from the Le Beau bottle.\"",
      "default": "Free U.S. shipping over $35. Most orders ship next-day."
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow customers to dismiss",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
