<section class="comparison" aria-label="One bottle vs Scent Gallery">
  <div class="container">
    <div class="comparison__with-image">

      <div class="comparison__card-wrap">
        <h2 class="comparison__headline">{{ section.settings.headline }}</h2>

        <div class="comparison__columns">
          <div class="comparison__col comparison__col--old">
            <span class="comparison__col-label">{{ section.settings.old_label }}</span>
            {%- if section.settings.old_sublabel != blank -%}
              <span class="comparison__col-sublabel">{{ section.settings.old_sublabel }}</span>
            {%- endif -%}
            <ul class="comparison__list">
              {%- for i in (1..4) -%}
                {%- assign item_key = 'old_item_' | append: i -%}
                {%- assign item_val = section.settings[item_key] -%}
                {%- if item_val != blank -%}
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    {{ item_val }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

          <div class="comparison__col comparison__col--new">
            <span class="comparison__col-label">{{ section.settings.new_label }}</span>
            {%- if section.settings.new_sublabel != blank -%}
              <span class="comparison__col-sublabel">{{ section.settings.new_sublabel }}</span>
            {%- endif -%}
            <ul class="comparison__list">
              {%- for i in (1..4) -%}
                {%- assign item_key = 'new_item_' | append: i -%}
                {%- assign item_val = section.settings[item_key] -%}
                {%- if item_val != blank -%}
                  <li>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                    {{ item_val }}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>

        <p class="comparison__tagline">{{ section.settings.tagline }}</p>
        {%- if section.settings.trust_cue != blank -%}
          {%- render 'cta-trust-cue', icon: 'shield', label: section.settings.trust_cue -%}
        {%- endif -%}
        <a href="{{ section.settings.cta_url }}" class="btn-primary comparison__cta">{{ section.settings.cta_text }}</a>
        {%- if section.settings.reassurance != blank -%}
          <span class="cta-trust-reassurance">{{ section.settings.reassurance }}</span>
        {%- endif -%}
      </div>

      <div class="comparison__receipt">
        <div class="receipt__header">
          <span class="receipt__eyebrow">{{ section.settings.receipt_eyebrow }}</span>
          <h3 class="receipt__subtitle"><em>{{ section.settings.receipt_subtitle }}</em></h3>
        </div>
        <ul class="receipt__lines" role="list">
          {%- for i in (1..6) -%}
            {%- assign name_key = 'receipt_name_' | append: i -%}
            {%- assign size_key = 'receipt_size_' | append: i -%}
            {%- assign price_key = 'receipt_price_' | append: i -%}
            {%- assign name_val = section.settings[name_key] -%}
            {%- assign price_val = section.settings[price_key] -%}
            {%- if name_val != blank -%}
              <li class="receipt__line" data-price="{{ price_val }}">
                <span class="receipt__name">
                  {{ name_val }}
                  {%- assign size_val = section.settings[size_key] -%}
                  {%- if size_val != blank -%}
                    <span class="receipt__size">{{ size_val }}</span>
                  {%- endif -%}
                </span>
                <span class="receipt__price">${{ price_val }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <div class="receipt__sep"></div>
        <div class="receipt__total">
          <span class="receipt__total-label">6 fragrances, tried</span>
          <span class="receipt__total-value" id="receipt-running-total">$0</span>
        </div>
        <div class="receipt__vs-row">
          <span class="receipt__vs-label">vs. one full bottle</span>
          <span class="receipt__vs-price">$300+</span>
        </div>
      </div>

    </div>
  </div>
</section>

