<section class="comparison" aria-label="One bottle vs Scent Gallery">
  <div class="container">
    <div class="comparison__card-wrap comparison__card-wrap--solo">
      <h2 class="comparison__headline">{{ section.settings.headline }}</h2>

      <div class="comparison__columns">
        <div class="comparison__col comparison__col--old">
          <span class="comparison__col-label">{{ section.settings.old_label }}</span>
          {%- if section.settings.old_sublabel != blank -%}
            <span class="comparison__col-sublabel">{{ section.settings.old_sublabel }}</span>
          {%- endif -%}
          <ul class="comparison__list">
            {%- for i in (1..4) -%}
              {%- assign item_key = 'old_item_' | append: i -%}
              {%- assign item_val = section.settings[item_key] -%}
              {%- if item_val != blank -%}
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  {{ item_val }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="comparison__col comparison__col--new">
          <span class="comparison__col-label">{{ section.settings.new_label }}</span>
          {%- if section.settings.new_sublabel != blank -%}
            <span class="comparison__col-sublabel">{{ section.settings.new_sublabel }}</span>
          {%- endif -%}
          <ul class="comparison__list">
            {%- for i in (1..4) -%}
              {%- assign item_key = 'new_item_' | append: i -%}
              {%- assign item_val = section.settings[item_key] -%}
              {%- if item_val != blank -%}
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {{ item_val }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>

      {%- if section.settings.tagline != blank -%}
        <p class="comparison__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      <a href="{{ section.settings.cta_url }}" class="btn-primary comparison__cta">{{ section.settings.cta_text }}</a>
      {%- if section.settings.reassurance != blank -%}
        <span class="cta-trust-reassurance">{{ section.settings.reassurance }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Ten scents for the price of one."
    },
    {
      "type": "text",
      "id": "old_label",
      "label": "Old column label",
      "default": "Blind Buy"
    },
    {
      "type": "text",
      "id": "old_sublabel",
      "label": "Old column sub-label",
      "info": "Small caption under the column label (e.g. plain-language clarification).",
      "default": "one full bottle"
    },
    {
      "type": "text",
      "id": "old_item_1",
      "label": "Old item 1",
      "default": "$300 up front"
    },
    {
      "type": "text",
      "id": "old_item_2",
      "label": "Old item 2",
      "default": "Locked into one fragrance"
    },
    {
      "type": "text",
      "id": "old_item_3",
      "label": "Old item 3",
      "default": "No way to try first"
    },
    {
      "type": "text",
      "id": "old_item_4",
      "label": "Old item 4",
      "default": "Stuck with buyer's remorse"
    },
    {
      "type": "text",
      "id": "new_label",
      "label": "New column label",
      "default": "Scent Gallery"
    },
    {
      "type": "text",
      "id": "new_sublabel",
      "label": "New column sub-label",
      "info": "Optional small caption under the column label. Leave blank to match the brand-name treatment."
    },
    {
      "type": "text",
      "id": "new_item_1",
      "label": "New item 1",
      "default": "From $4.99 per scent"
    },
    {
      "type": "text",
      "id": "new_item_2",
      "label": "New item 2",
      "default": "10+ fragrances for the same price"
    },
    {
      "type": "text",
      "id": "new_item_3",
      "label": "New item 3",
      "default": "Try before you ever commit"
    },
    {
      "type": "text",
      "id": "new_item_4",
      "label": "New item 4",
      "default": "Rotate. Explore. Own your collection."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (optional)",
      "info": "Italic line above the CTA. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Build Your Rotation →"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line (below CTA)",
      "info": "Italic, soft. Optional.",
      "default": "Free U.S. shipping over $35"
    }
  ],
  "presets": [
    {
      "name": "Comparison"
    }
  ]
}
{% endschema %}
