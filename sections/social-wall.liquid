{%- comment -%}
  Homepage TikTok social wall — same comment screenshots as the PDP swiper,
  rendered as a wall above testimonials. Honest day-one social proof.
{%- endcomment -%}

{%- comment -%}
  Curated ordering: comment_order is an explicit, comma-separated list of
  comment-NN.png numbers, ranked by CRO leverage (objection-bunking,
  specificity, identity reinforcement). Falls back to comment-01..comment-NN
  if blank, using asset_image_count.
{%- endcomment -%}
{%- assign comment_order = section.settings.comment_order | default: '' -%}
{%- if comment_order != blank -%}
  {%- assign comment_list = comment_order | replace: ' ', '' | split: ',' -%}
  {%- assign asset_count = comment_list.size -%}
{%- else -%}
  {%- assign asset_count = section.settings.asset_image_count | default: 12 -%}
  {%- assign comment_list = '' | split: ',' -%}
{%- endif -%}

{%- if section.settings.title == blank -%}
  {%- assign layout = 'marquee' -%}
{%- else -%}
  {%- assign layout = 'swiper' -%}
{%- endif -%}

{%- if asset_count > 0 -%}
  <section class="social-wall" data-layout="{{ layout }}" aria-label="TikTok community comments">
    <div class="container social-wall__inner">
      {%- if layout == 'marquee' -%}
        <div class="social-wall__eyebrow reveal">
          <svg class="social-wall__tiktok-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.81a8.18 8.18 0 004.78 1.52V6.88a4.85 4.85 0 01-1.01-.19z"/>
          </svg>
          <span class="social-wall__overline">{{ section.settings.overline }}</span>
        </div>
      {%- else -%}
        <header class="social-wall__header reveal">
          <svg class="social-wall__tiktok-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.28 6.28 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.81a8.18 8.18 0 004.78 1.52V6.88a4.85 4.85 0 01-1.01-.19z"/>
          </svg>
          <div class="social-wall__heading">
            <span class="social-wall__overline">{{ section.settings.overline }}</span>
            <h2 class="social-wall__title">{{ section.settings.title }}</h2>
            {%- if section.settings.subtext != blank -%}
              <p class="social-wall__sub">{{ section.settings.subtext }}</p>
            {%- endif -%}
          </div>
        </header>
      {%- endif -%}

      <div class="swiper social-wall__swiper" id="social-wall-swiper">
        <div class="swiper-wrapper">
          {%- if comment_list.size > 0 -%}
            {%- for raw in comment_list -%}
              {%- assign n = raw | prepend: '0' | slice: -2, 2 -%}
              {%- assign cname = 'comment-' | append: n -%}
              <div class="swiper-slide social-wall__slide">
                {% render 'picture-asset', filename: cname, alt: 'TikTok community comment screenshot', loading: 'lazy' %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..asset_count) -%}
              {%- assign n = i | prepend: '0' | slice: -2, 2 -%}
              {%- assign cname = 'comment-' | append: n -%}
              <div class="swiper-slide social-wall__slide">
                {% render 'picture-asset', filename: cname, alt: 'TikTok community comment screenshot', loading: 'lazy' %}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if layout == 'swiper' -%}
          <div class="swiper-pagination social-wall__pagination"></div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Social Wall",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "From the @scentgallery_ TikTok community"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What collectors are actually saying."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "info": "Optional.",
      "default": "Real comments. Real fragheads. No filters, no edits."
    },
    {
      "type": "text",
      "id": "comment_order",
      "label": "Curated comment order (top-leverage first)",
      "info": "Comma-separated comment-NN.png numbers in render order. Ranked by /cro: objection-bunking, specificity, ICP voice. Leave blank to use sequential count below.",
      "default": "01,10,08,12,05,11,02,04"
    },
    {
      "type": "range",
      "id": "asset_image_count",
      "label": "Sequential fallback count",
      "info": "Used only if curated order is blank. Renders comment-01.png through comment-NN.png in numerical order.",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Social Wall"
    }
  ]
}
{% endschema %}
